// A tour of lumen. Run it with:
//   cargo run -- examples/demo.lm            (bytecode VM)
//   cargo run -- --interp examples/demo.lm   (tree-walking interpreter)

fn gcd(a: int, b: int) -> int {
    while b != 0 {
        let t = b;
        b = a % b;
        a = t;
    }
    return a;
}

fn fib(n: int) -> int {
    if n < 2 { return n; }
    return fib(n - 1) + fib(n - 2);
}

fn is_prime(n: int) -> bool {
    if n < 2 { return false; }
    let d = 2;
    while d * d <= n {
        if n % d == 0 { return false; }
        d = d + 1;
    }
    return true;
}

fn average(a: float, b: float) -> float {
    return (a + b) / 2.0;
}

// count the primes below 100
let count = 0;
let n = 0;
while n < 100 {
    if is_prime(n) { count = count + 1; }
    n = n + 1;
}

let greeting = "hello from " + "lumen";
print(greeting);

if average(1.5, 2.5) == 2.0 && gcd(48, 18) == 6 {
    print("checks passed");
} else {
    print("checks failed");
}

// The value of the last expression statement is the result of the program:
// 25 primes below 100, plus fib(10) = 55.
count + fib(10);
